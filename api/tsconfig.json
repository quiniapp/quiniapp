{
  "extends":"../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    // ES2022 por `new Error(msg, { cause })`. La API corre en Node 26.
    "lib": ["ES2022"],
    "module": "ES2020",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@helper/*": ["../helper/*"], // 👈 resolvé hacia arriba
      "@database/*": ["./database/*"],
      // Antes resolvían por `baseUrl` (TS 6 lo deprecó): imports como `src/cache/CacheManager`.
      "src/*": ["./src/*"],
      "envs": ["./envs.ts"]
    }
  },
  "include": ["src", "middlewares", "helper", "*.ts", "database", "../helper"]
}
