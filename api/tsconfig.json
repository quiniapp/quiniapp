{
  "extends":"../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".", // base del helper
    "paths": {
      "@helper/*": ["../helper/*"], // 👈 resolvé hacia arriba
      "@database/*": ["./database/*"]
    }
  },
  "include": ["src", "middlewares", "helper", "*.ts", "database", "../helper"]
}
