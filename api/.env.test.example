# =====================================
# Environment Configuration - TEST
# =====================================
# Este archivo es un EJEMPLO. Copia este archivo a .env.test y configura tus valores.
# IMPORTANTE: .env.test NO debe commitearse a git (ya está en .gitignore)

ENVIROMENT=TEST
NODE_ENV=test
SUPABASE_ENVIROMENT=LOCAL
FRONT_URL_ENVIROMENT=DEVELOP

# =====================================
# API Configuration
# =====================================
PORT=3001
URL=http://localhost

# =====================================
# Database Configuration - SUPABASE LOCAL TEST
# =====================================
# IMPORTANTE: Estos son los puertos del supabase-test (segundo Supabase local)
# NO son los puertos de tu Supabase de desarrollo (54321/54322)

# URL del API de Supabase test (puerto 54331, NO 54321)
SUPABASE_URL_LOCAL=http://localhost:54331

# Service role key de Supabase test (clave por defecto de Supabase local)
# Esta es la clave que Supabase genera automáticamente al hacer "supabase start"
SUPABASE_SERVICE_ROLE_KEY_LOCAL=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# JWT secret de Supabase local (secreto por defecto)
JWT_SECRET_SUPABASE_LOCAL=super-secret-jwt-token-with-at-least-32-characters-long

# NO CONFIGURAR credenciales remotas (tests son SOLO locales)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# JWT_SECRET_SUPABASE=

# =====================================
# JWT Secrets (Custom Authentication)
# =====================================
# Genera secretos únicos para tests (256 bits):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET_ACCESS=test_access_secret_256_bit_replace_with_random_value
JWT_SECRET_REFRESH=test_refresh_secret_256_bit_replace_with_random_value
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=30d

# =====================================
# Session Management
# =====================================
SESSION_INACTIVITY_TIMEOUT=4h
SESSION_SLIDING_WINDOW=15m
SESSION_ABSOLUTE_TIMEOUT=30d
SESSION_CLEANUP_INTERVAL=1h

# =====================================
# Security Configuration
# =====================================
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=15m
BCRYPT_ROUNDS=10
MAX_CONCURRENT_SESSIONS=0

# =====================================
# Cookie Configuration
# =====================================
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# =====================================
# Frontend URLs
# =====================================
FRONT_URL_PRODUCTION=http://localhost:5173
FRONT_URL_DEVELOP=http://localhost:5173
FRONT_URL_DEV=http://localhost:5173

# =====================================
# CORS Configuration
# =====================================
ALLOW_VERCEL_PREVIEWS=false
CORS_EXTRA_ORIGINS=

# =====================================
# Organization
# =====================================
# Dejar vacío - los tests crean organizaciones temporales
DEFAULT_ORG_ID=
