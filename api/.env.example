# =====================================
# Environment Configuration
# =====================================
ENVIROMENT=LOCAL
NODE_ENV=development
SUPABASE_ENVIROMENT=LOCAL
FRONT_URL_ENVIROMENT=DEVELOP

# =====================================
# API Configuration
# =====================================
PORT=3000
URL=http://localhost

# =====================================
# Database Configuration (Supabase)
# =====================================
SUPABASE_URL_LOCAL=your_local_supabase_url
SUPABASE_URL=your_remote_supabase_url
SUPABASE_SERVICE_ROLE_KEY_LOCAL=your_local_service_role_key
SUPABASE_SERVICE_ROLE_KEY=your_remote_service_role_key
JWT_SECRET_SUPABASE_LOCAL=your_local_supabase_jwt_secret
JWT_SECRET_SUPABASE=your_remote_supabase_jwt_secret

# =====================================
# JWT Secrets (Custom Authentication)
# =====================================
# Legacy user token secret (deprecated - will be removed in Phase 5)
JWT_SECRET_USER=your_user_token_secret

# NEW: Access token secret (15 minutes expiration)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET_ACCESS=your_256_bit_secret_here

# NEW: Refresh token secret (30 days expiration)
# MUST BE DIFFERENT from JWT_SECRET_ACCESS
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET_REFRESH=your_different_256_bit_secret_here

# JWT Token Durations
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=30d

# =====================================
# Session Management
# =====================================
# Session inactivity timeout (4 hours - time without activity before session expires)
SESSION_INACTIVITY_TIMEOUT=4h

# Sliding window extension (15 minutes - how much to extend session per activity)
SESSION_SLIDING_WINDOW=15m

# Absolute session timeout (30 days - maximum session lifetime regardless of activity)
SESSION_ABSOLUTE_TIMEOUT=30d

# Session cleanup interval (1 hour - how often to cleanup expired sessions)
SESSION_CLEANUP_INTERVAL=1h

# =====================================
# Security Configuration
# =====================================
# Maximum failed login attempts before account lockout
MAX_FAILED_LOGIN_ATTEMPTS=5

# Account lockout duration after max failed attempts (15 minutes)
ACCOUNT_LOCKOUT_DURATION=15m

# Bcrypt rounds for password hashing (12 = secure, higher = more secure but slower)
BCRYPT_ROUNDS=12

# Maximum concurrent sessions per user (0 = unlimited)
MAX_CONCURRENT_SESSIONS=0

# =====================================
# Cookie Configuration
# =====================================
# Cookie domain (for multi-subdomain support, e.g., .yourdomain.com)
COOKIE_DOMAIN=

# Cookie secure flag (true in production, false in local development)
COOKIE_SECURE=false

# Cookie sameSite policy (none, lax, or strict)
COOKIE_SAME_SITE=lax

# =====================================
# Frontend URLs
# =====================================
FRONT_URL_PRODUCTION=https://your-production-url.com
FRONT_URL_DEVELOP=http://localhost:5173
FRONT_URL_DEV=http://localhost:5173

# =====================================
# CORS Configuration
# =====================================
# Allow Vercel preview deployments
ALLOW_VERCEL_PREVIEWS=false

# Extra CORS origins (comma-separated)
CORS_EXTRA_ORIGINS=

# =====================================
# Organization
# =====================================
DEFAULT_ORG_ID=your_default_organization_id
