{
    "name": "api",
    "version": "1.0.0",
    "main": "/src/index.ts",
    "type": "module",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "dev": "tsx watch src/index.ts",
        "lint": "eslint 'src/**/*.{ts,tsx}'",
        "format": "prettier --write 'src/**/*.{ts,tsx,json,md}'",
        "test": "dotenv -e .env.test -- cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand --detectOpenHandles",
        "test:watch": "dotenv -e .env.test -- cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --watch --runInBand",
        "test:coverage": "dotenv -e .env.test -- cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand",
        "test:verify": "dotenv -e .env.test -- tsx scripts/verify-test-env.ts",
        "supabase:test:start": "cd supabase-test && npx supabase start",
        "supabase:test:stop": "cd supabase-test && npx supabase stop",
        "supabase:test:reset": "cd supabase-test && npx supabase db reset",
        "supabase:test:status": "cd supabase-test && npx supabase status"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.49.4",
        "@types/node-cron": "^3.0.11",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "csrf-csrf": "^4.0.3",
        "dayjs": "^1.11.13",
        "dotenv": "^16.4.7",
        "express": "^4.18.2",
        "express-rate-limit": "^8.2.1",
        "express-slow-down": "^3.1.0",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.10.0",
        "ms": "^2.1.3",
        "node-cron": "^4.2.1",
        "pg": "^8.14.1",
        "postgres": "^3.4.5",
        "uuid": "^11.1.0",
        "winston": "^3.19.0",
        "zod": "^3.24.3"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.8",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.1",
        "@types/jest": "^29.5.11",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.9",
        "@types/ms": "^2.1.0",
        "@types/node": "^22.19.3",
        "@types/supertest": "^6.0.2",
        "cross-env": "^10.1.0",
        "dotenv-cli": "^11.0.0",
        "jest": "^29.7.0",
        "supabase": "^2.65.5",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "tsx": "^4.19.3",
        "typescript": "^5.9.3"
    }
}
