{
    "name": "api",
    "version": "1.0.0",
    "main": "/src/index.ts",
    "type": "module",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "dev": "tsx watch src/index.ts",
        "start": "tsx src/index.ts",
        "lint": "eslint 'src/**/*.{ts,tsx}'",
        "format": "prettier --write 'src/**/*.{ts,tsx,json,md}'",
        "test": "dotenv-cli -e .env.test -- cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand --detectOpenHandles",
        "test:watch": "dotenv-cli -e .env.test -- cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --watch --runInBand",
        "test:coverage": "dotenv-cli -e .env.test -- cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand",
        "test:verify": "dotenv-cli -e .env.test -- tsx scripts/verify-test-env.ts",
        "supabase:test:start": "cd supabase-test && npx supabase start",
        "supabase:test:stop": "cd supabase-test && npx supabase stop",
        "supabase:test:reset": "cd supabase-test && npx supabase db reset",
        "supabase:test:status": "cd supabase-test && npx supabase status"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.119.2",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dayjs": "^1.11.23",
        "dotenv": "^18.0.10",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.5",
        "express-slow-down": "^3.1.1",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.12.1",
        "ms": "^2.1.3",
        "node-cron": "^4.6.0",
        "winston": "^3.19.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/ms": "^2.1.0",
        "@types/node": "^26.6.6",
        "cross-env": "^10.1.0",
        "dotenv-cli": "^11.1.0",
        "jest": "^30.5.2",
        "supabase": "^3.3.0",
        "ts-jest": "^29.4.15",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3"
    }
}
