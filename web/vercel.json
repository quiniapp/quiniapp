{
  "buildCommand": "npm install --legacy-peer-deps && npm run build",
  "build": {
    "env": {
      "NPM_CONFIG_FROZEN_LOCKFILE": "false"
    }
  },
  "functions": {
    "api/api-proxy.ts": {
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/api-proxy"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
