{
  "buildCommand": "npm ci && npm run build",
  "build": {
    "env": {
      "NPM_CONFIG_FROZEN_LOCKFILE": "false"
    }
  },
  "functions": {
    "api/*.ts": {
      "runtime": "nodejs22.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/api-proxy"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}