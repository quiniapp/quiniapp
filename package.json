    "lint": "npm run lint --workspaces",
    "format": "npm run format --workspaces",
    "build": "npm run build --workspaces",
    "prepare": "node scripts/prepare.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quiniapp/quiniapp.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/quiniapp/quiniapp/issues"
  },
  "homepage": "https://github.com/quiniapp/quiniapp#readme",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
