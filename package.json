{
  "name": "quiniapp",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "workspaces": [
    "api",
    "web",
    "helper",
    "polla-web"
  ],
  "scripts": {
    "api-install": "npm install --workspace api",
    "api": "npm run dev --workspace api",
    "web-install": "npm install --workspace web",
    "web": "npm run dev --workspace web",
    "lint": "npm run lint --workspaces",
    "format": "npm run format --workspaces",
    "build": "npm run build --workspaces",
    "prepare": "node scripts/prepare.js",
    "polla-web": "npm run dev --workspace polla-web",
    "polla-web-install": "npm install --workspace polla-web"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quiniapp/quiniapp.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "bugs": {
    "url": "https://github.com/quiniapp/quiniapp/issues"
  },
  "homepage": "https://github.com/quiniapp/quiniapp#readme",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "@types/express-serve-static-core": "5.0.6",
    "@jest/reporters": {
      "glob": "^14.0.6"
    },
    "jest-config": {
      "glob": "^14.0.6"
    },
    "jest-runtime": {
      "glob": "^14.0.6"
    },
    "test-exclude": {
      "glob": "^14.0.6",
      "minimatch": "^11.0.9"
    }
  }
}
